{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "agents": {
    "build": {
      "category": "most-capable",
      "variant": "max",
      "mode": "primary"
    },
    "oracle": {
      "model": "codex",
      "variant": "max",
      "mode": "subagent"
    },
    "explore": {
      "category": "quick",
      "variant": "medium",
      "mode": "subagent"
    },
    "librarian": {
      "category": "general",
      "variant": "medium",
      "mode": "subagent"
    },
    "Sisyphus": {
      "category": "most-capable",
      "variant": "max",
      "mode": "primary"
    },
    "Sisyphus-Junior": {
      "category": "general",
      "variant": "max",
      "mode": "subagent"
    },
    "Prometheus (Planner)": {
      "category": "general",
      "variant": "high",
      "mode": "primary"
    },
    "general": {
      "category": "general",
      "variant": "high",
      "mode": "subagent"
    },
    "frontend-ui-ux-engineer": {
      "category": "general",
      "variant": "high",
      "mode": "subagent"
    },
    "document-writer": {
      "category": "quick",
      "variant": "medium",
      "mode": "subagent"
    },
    "multimodal-looker": {
      "category": "general",
      "variant": "high",
      "mode": "subagent"
    }
  },
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  }
}
